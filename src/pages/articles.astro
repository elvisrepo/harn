---
import Base from '../layouts/Base.astro';
import { listMods, type ModView } from '../lib/mods.ts';

interface ArticleChild {
  title: string;
  url: string;
  key: string;
  blurb: string;
}

interface Article {
  title: string;
  url: string;
  key: string;
  blurb: string;
  children?: ArticleChild[];
}

const articles: Article[] = [
  {
    title: 'Harness engineering for coding agent users',
    url: 'https://martinfowler.com/articles/harness-engineering.html',
    key: 'harness-engineering.html',
    blurb: 'Böckeler’s blueprint: guides/sensors, steering loop, keep-quality-left. This harness is built from its figures — every Fig-2 row and lifecycle tool reviewed 1-by-1.',
  },
  {
    title: 'Maintainability sensors for coding agents',
    url: 'https://martinfowler.com/articles/sensors-for-coding-agents.html',
    key: 'sensors-for-coding-agents',
    blurb: 'Sensor experiments with receipts: linting craft, dependency rules, coupling data, modularity review, mutation testing, the sidecar. Our sensor ring’s field manual.',
  },
  {
    title: 'Harness engineering: leveraging Codex in an agent-first world',
    url: 'https://openai.com/index/harness-engineering/',
    key: 'openai.com/index/harness-engineering',
    blurb: 'Agent-first at scale: legibility, invariants-not-implementations, garbage collection. Our newest lens — observability, direction notes, and boundary parsing trace to it.',
  },
  {
    title: 'The New SDLC With Vibe Coding — Osmani et al.',
    url: 'https://www.kaggle.com/whitepaper-the-new-SDLC-with-vibe-coding',
    key: 'whitepaper-the-new-SDLC-with-vibe-coding',
    blurb: 'Syntax-to-intent spectrum, context engineering, factory model, conductor/orchestrator, CapEx/OpEx. Gave us the static-dynamic mod; trajectory, flywheel, and trade-off folds.',
  },
  {
    title: 'Agent Tools & Interoperability (Day 2) — MCP, A2A, A2UI, Commerce',
    url: 'https://www.kaggle.com/whitepaper-agent-tools-and-interoperability-with-mcp',
    key: 'whitepaper-agent-tools-and-interoperability-with-mcp',
    blurb: 'Consume-don’t-build, NxM→N+M, bounded-vs-unbounded, validate-retry-fallback, intent catalogs. New bounded mod; MCP/errors/skills/archify/audit sharpened.',
  },
  {
    title: 'Agent Skills (Day 3) — Procedural Memory Primitive',
    url: 'https://www.kaggle.com/whitepaper-agent-skills',
    key: 'whitepaper-agent-skills',
    blurb: 'Skills as procedural memory: routing descriptions, boring names, folder split, crystallize-and-review. Skills mod rewritten; AGENTS.md and graph-worthiness linked.',
  },
  {
    title: 'Learn Harness Engineering — WalkingLabs course',
    url: 'https://walkinglabs.github.io/learn-harness-engineering/en/',
    key: 'learn-harness-engineering/en',
    blurb: 'A full course, read lecture-by-lecture. Each lecture below lists the catalog mods it produced — the course is the parent, lectures are the units.',
    children: [
      {
        title: 'Lecture 01. Strong Models Don’t Mean Reliable Execution',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-01-why-capable-agents-still-fail/',
        key: 'lecture-01-why-capable-agents-still-fail',
        blurb: 'Capability ≠ reliability, five failure layers, Definition of Done per task, fix-the-harness-first. Gave us DoD, verification-gap, and context-anxiety mods.',
      },
      {
        title: 'Lecture 02. What a Harness Actually Is',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-02-what-a-harness-actually-is/',
        key: 'lecture-02-what-a-harness-actually-is',
        blurb: 'Five subsystems (instructions/tools/environment/state/feedback), ablation tests, harness rots like code. Gave us progress-file, subsystem-audit, and ablation mods.',
      },
      {
        title: 'Lecture 03. Why the Repository Must Become the System of Record',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-03-why-the-repository-must-become-the-system-of-record/',
        key: 'lecture-03-why-the-repository-must-become-the-system-of-record',
        blurb: 'Knowledge outside the repo doesn’t exist for the agent. Fresh-session test, knowledge next to code, ACID state — anchored by our completed single-source-of-truth mod.',
      },
      {
        title: 'Lecture 04. Split Instructions Across Files',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-04-why-one-giant-instruction-file-fails/',
        key: 'lecture-04-why-one-giant-instruction-file-fails',
        blurb: '“Add a rule” is relief today, poison tomorrow. Entry-as-router, SNR audits, topic docs — sharpened our AGENTS.md mod and added the SNR-audit mod.',
      },
      {
        title: 'Lecture 05. Keeping Context Alive Across Sessions',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-05-why-long-running-tasks-lose-continuity/',
        key: 'lecture-05-why-long-running-tasks-lose-continuity',
        blurb: '/compact keeps the what, drops the why. Decision log + handoff routine as its file complement; progress and context-anxiety mods sharpened.',
      },
      {
        title: 'Lecture 06. Make the Agent Initialize Before Every Work Session',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-06-why-initialization-needs-its-own-phase/',
        key: 'lecture-06-why-initialization-needs-its-own-phase',
        blurb: 'Half inapplicable locally: persistent env needs no reinstall ritual. The live half — readiness checklist + task breakdown — gave one new mod, two links.',
      },
      {
        title: 'Lecture 07. Draw Clear Task Boundaries for Agents',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-07-why-agents-overreach-and-under-finish/',
        key: 'lecture-07-why-agents-overreach-and-under-finish',
        blurb: 'Finish one before starting the next: WIP=1, executable completion evidence, scope as a file. One new mod; DoD and breakdown linked.',
      },
      {
        title: 'Lecture 08. Use Feature Lists to Constrain What the Agent Does',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-08-why-feature-lists-are-harness-primitives/',
        key: 'lecture-08-why-feature-lists-are-harness-primitives',
        blurb: 'Consolidation, not novelty: the list as executable primitive hardened our breakdown — no new mod, three links.',
      },
      {
        title: 'Lecture 09. Preventing Agents from Declaring Victory Too Early',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-09-why-agents-declare-victory-too-early/',
        key: 'lecture-09-why-agents-declare-victory-too-early',
        blurb: 'Feelings aren’t verification: leveled termination, actionable errors, worker/checker split. New errors mod; DoD leveled; gap-log, reviews, WIP-1 linked.',
      },
      {
        title: 'Lecture 10. Only a Full Pipeline Run Counts as Real Verification',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-10-why-end-to-end-testing-changes-results/',
        key: 'lecture-10-why-end-to-end-testing-changes-results',
        blurb: 'Unit tests are blind at boundaries; e2e changes how agents code. No new mod — errors mod sharpened, DoD/steering/dep-cruiser/browser-qa linked.',
      },
      {
        title: 'Lecture 11. Making the Agent’s Runtime Observable',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-11-why-observability-belongs-inside-the-harness/',
        key: 'lecture-11-why-observability-belongs-inside-the-harness',
        blurb: 'Runtime layer covered, process layer half-new: sprint-contract mod minted, reviewers get a rubric; observability + steering linked.',
      },
      {
        title: 'Lecture 12. Leave a Clean Handoff at the End of Every Session',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-12-why-every-session-must-leave-a-clean-state/',
        key: 'lecture-12-why-every-session-must-leave-a-clean-state',
        blurb: 'Exit checklist + idempotent cleanup into handoff, quality-doc mod minted, ablation turned inward; fast-merge philosophy marked not-us.',
      },
      {
        title: 'Lecture 13. From Manual Prompting to Autonomous Loops',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-13-loop-engineering/',
        key: 'lecture-13-loop-engineering',
        blurb: 'The floor above: silent-costs mod minted, methodology file parked as horizon; maker/checker, loop memory, goal triple linked.',
      },
      {
        title: 'Lecture 14. From Single Loops to Graph Engineering',
        url: 'https://walkinglabs.github.io/learn-harness-engineering/en/lectures/lecture-14-graph-engineering/',
        key: 'lecture-14-graph-engineering',
        blurb: 'Threshold, not tool: worthiness test minted (default don’t draw), anchors into methodology, fresh-context into reviews. Course complete.',
      },
    ],
  },
];

function linksOf(m: ModView): { label: string; url: string }[] {
  const raw = m.links as unknown;
  if (Array.isArray(raw)) return raw as { label: string; url: string }[];
  try {
    const parsed: unknown = JSON.parse(String(raw ?? '[]'));
    return Array.isArray(parsed) ? (parsed as { label: string; url: string }[]) : [];
  } catch {
    return [];
  }
}

const mods = await listMods();
const matchKey = (m: ModView, key: string) =>
  linksOf(m).some((l) => typeof l?.url === 'string' && l.url.includes(key));
const withArticles = articles.map((a) => {
  const childKeys = (a.children ?? []).map((c) => c.key);
  return {
    ...a,
    // Direct matches only: mods pointing at the parent but at no child.
    mods: mods.filter((m) => matchKey(m, a.key) && !childKeys.some((k) => matchKey(m, k))),
    children: (a.children ?? []).map((c) => ({
      ...c,
      mods: mods.filter((m) => matchKey(m, c.key)),
    })),
  };
});
const claimed = new Set(withArticles.flatMap((a) => [...a.mods, ...a.children.flatMap((c) => c.mods)].map((m) => m.slug)));
const unmapped = mods.filter((m) => !claimed.has(m.slug));
const session = Astro.locals.session;
---

<Base title="Harness Mods — AI articles" session={session}>
  <p class="kicker">Harness — reading</p>
  <h1>AI articles we work from</h1>
  <p class="muted">
    Six papers plus one course, read 1-by-1. Each lists the catalog mods that trace to
    it (matched on mod links) — the receipts that the reading turned
    into harness.
  </p>

  <div class="card">
    <h2 style="margin-top:0">Preferred mods</h2>
    <p class="muted small" style="margin:.3rem 0 .8rem">
      Your shortlist — starred below, or your own entries. Kept in this browser only.
    </p>
    <p class="small" id="preferred"><span class="muted">No preferred mods yet — star any mod below.</span></p>
    <form id="custom-pref" style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.6rem">
      <input id="cp-name" type="text" placeholder="Mod name (e.g. Definition of Done)" maxlength="80" style="flex:2;min-width:180px" />
      <input id="cp-note" type="text" placeholder="Description…" maxlength="280" style="flex:3;min-width:220px" />
      <button type="submit">Add</button>
      <button type="button" id="cp-div" title="Add a separator line (must-mods above, strong consideration below)">+ divider</button>
    </form>
  </div>

  {withArticles.map((a) => (
    <div class="card">
      <h2 style="margin-top:0">
        <a href={a.url} target="_blank" rel="noreferrer">{a.title} ↗</a>
      </h2>
      <p class="muted small" style="margin:.3rem 0 .8rem">{a.blurb}</p>
      {a.mods.length === 0 && !a.children.length && (
        <p class="muted">No mods link here yet.</p>
      )}
      {(a.mods.length > 0 || !a.children.length) && (
        <details>
          <summary style="cursor:pointer">Show all {a.mods.length} mods</summary>
          <table class="kv">
            <tbody>
              {a.mods.map((m) => (
                <tr>
                  <td><button class="star" data-slug={m.slug} title="Star as preferred" aria-label={`Star ${m.title}`}>☆</button> <a class="prev" data-sum={m.summary} href={`/mods/${m.slug}`}>{m.title}</a></td>
                  <td class="small muted">{m.category}</td>
                  <td class="small">
                    {m.implemented ? '● implemented' : m.wanted ? '○ wanted' : m.considered ? '◐ considered' : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      )}
      {a.children.map((c) => (
        <details style="margin-top:1rem;border-top:1px dashed var(--border);padding-top:.8rem">
          <summary style="cursor:pointer;font-size:1rem;font-weight:bold">
            <a href={c.url} target="_blank" rel="noreferrer">{c.title} ↗</a>
            <span class="muted small" style="font-weight:normal"> ({c.mods.length} mods)</span>
          </summary>
          <p class="muted small" style="margin:.4rem 0 .6rem">{c.blurb}</p>
          {c.mods.length === 0 ? (
            <p class="muted">No mods link here yet.</p>
          ) : (
            <details>
              <summary style="cursor:pointer">Show all {c.mods.length} mods</summary>
              <table class="kv">
                <tbody>
                  {c.mods.map((m) => (
                    <tr>
                      <td><button class="star" data-slug={m.slug} title="Star as preferred" aria-label={`Star ${m.title}`}>☆</button> <a class="prev" data-sum={m.summary} href={`/mods/${m.slug}`}>{m.title}</a></td>
                      <td class="small muted">{m.category}</td>
                      <td class="small">
                        {m.implemented ? '● implemented' : m.wanted ? '○ wanted' : m.considered ? '◐ considered' : '—'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          )}
        </details>
      ))}
    </div>
  ))}

  <div class="card">
    <h2 style="margin-top:0">Not yet mapped ({unmapped.length})</h2>
    <p class="muted small" style="margin:.3rem 0 .8rem">
      Catalog mods with no article link — older entries from before the
      reading program, not necessarily uncovered. Map them by adding the
      article URL to their seed links.
    </p>
    <details>
      <summary style="cursor:pointer">Show all {unmapped.length} unmapped mods</summary>
      <p class="small">
        {unmapped.map((m, i) => (
          <span>{i > 0 && ' · '}<button class="star" data-slug={m.slug} title="Star as preferred" aria-label={`Star ${m.title}`}>☆</button><a class="prev" data-sum={m.summary} href={`/mods/${m.slug}`}>{m.title}</a></span>
        ))}
      </p>
    </details>
  </div>

  <script is:inline type="application/json" id="mod-index" set:html={JSON.stringify(mods.map((m) => ({ slug: m.slug, title: m.title }))).replace(/</g, '\\u003c')}></script>
  <script is:inline>
    const idx = JSON.parse(document.getElementById('mod-index').textContent || '[]');
    const bySlug = Object.fromEntries(idx.map((m) => [m.slug, m.title]));
    const KEY = 'preferred-mods';
    const CKEY = 'preferred-custom';
    const UKEY = 'preferred-order';
    // Unified ordered store (v2). Migrates the old two-key shape once.
    const loadAll = () => {
      try {
        const v = JSON.parse(localStorage.getItem(UKEY) || 'null');
        if (Array.isArray(v))
          return v.filter(
            (it) => it && (it.t === 'div' || (it.t === 'slug' ? bySlug[it.id] : typeof it.name === 'string')),
          );
      } catch {
        /* fall through to migration */
      }
      let slugs = [];
      let customs = [];
      try {
        const v = JSON.parse(localStorage.getItem(KEY) || '[]');
        if (Array.isArray(v)) slugs = v.filter((s) => typeof s === 'string' && bySlug[s]);
      } catch { /* ignore */ }
      try {
        const v = JSON.parse(localStorage.getItem(CKEY) || '[]');
        if (Array.isArray(v))
          customs = v.filter((e) => e && typeof e.name === 'string').map((e) => ({ t: 'custom', name: e.name.slice(0, 80), note: (e.note || '').slice(0, 280) }));
      } catch { /* ignore */ }
      return [...slugs.map((id) => ({ t: 'slug', id })), ...customs];
    };
    const saveAll = (items) => localStorage.setItem(UKEY, JSON.stringify(items.slice(0, 100)));
    const paint = () => {
      const items = loadAll();
      const slugs = items.filter((it) => it.t === 'slug').map((it) => it.id);
      const box = document.getElementById('preferred');
      if (!items.length) {
        box.innerHTML = '<span class="muted">No preferred mods yet — star any mod below.</span>';
      } else {
        const ol = document.createElement('ol');
        ol.className = 'preflist';
        items.forEach((it, pos) => {
          const li = document.createElement('li');
          li.setAttribute('draggable', 'true');
          li.dataset.pos = String(pos);
          const lab = document.createElement('span');
          lab.className = 'plab';
          if (it.t === 'div') {
            li.classList.add('divider');
            lab.remove();
          } else if (it.t === 'slug') {
            const a = document.createElement('a');
            a.href = `/mods/${it.id}`;
            a.textContent = bySlug[it.id];
            lab.appendChild(a);
          } else {
            const strong = document.createElement('strong');
            strong.textContent = it.name;
            lab.appendChild(strong);
            if (it.note) {
              const span = document.createElement('span');
              span.className = 'muted';
              span.textContent = ` — ${it.note}`;
              lab.appendChild(span);
            }
          }
          li.appendChild(lab);
          const mk = (glyph, title, fn) => {
            const b = document.createElement('button');
            b.className = 'mini';
            b.textContent = glyph;
            b.title = title;
            b.setAttribute('aria-label', title);
            b.addEventListener('click', fn);
            return b;
          };
          const ctl = document.createElement('span');
          ctl.className = 'pctl';
          ctl.appendChild(mk('✕', 'Remove', () => removeAt(pos)));
          li.appendChild(ctl);
          li.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', String(pos));
            e.dataTransfer.effectAllowed = 'move';
            li.classList.add('dragging');
          });
          li.addEventListener('dragend', () => li.classList.remove('dragging'));
          li.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            li.classList.add('dragover');
          });
          li.addEventListener('dragleave', () => li.classList.remove('dragover'));
          li.addEventListener('drop', (e) => {
            e.preventDefault();
            li.classList.remove('dragover');
            const from = Number(e.dataTransfer.getData('text/plain'));
            if (Number.isNaN(from) || from === pos) return;
            const list = loadAll();
            const [moved] = list.splice(from, 1);
            list.splice(pos, 0, moved);
            saveAll(list);
            paint();
          });
          ol.appendChild(li);
        });
        box.replaceChildren(ol);
      }
      document.querySelectorAll('button.star[data-slug]').forEach((b) => {
        const on = slugs.includes(b.dataset.slug);
        b.textContent = on ? '★' : '☆';
        b.classList.toggle('on', on);
      });
    };
    const removeAt = (pos) => {
      const items = loadAll();
      items.splice(pos, 1);
      saveAll(items);
      paint();
    };
    const toggleSlug = (slug) => {
      const items = loadAll();
      const i = items.findIndex((it) => it.t === 'slug' && it.id === slug);
      if (i >= 0) items.splice(i, 1);
      else items.push({ t: 'slug', id: slug });
      saveAll(items);
      paint();
    };
    document.querySelector('form#custom-pref').addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('cp-name').value.trim();
      const note = document.getElementById('cp-note').value.trim();
      if (!name) return;
      const items = loadAll();
      items.push({ t: 'custom', name: name.slice(0, 80), note: note.slice(0, 280) });
      saveAll(items);
      document.getElementById('cp-name').value = '';
      document.getElementById('cp-note').value = '';
      paint();
    });
    document.getElementById('cp-div').addEventListener('click', () => {
      const items = loadAll();
      items.push({ t: 'div' });
      saveAll(items);
      paint();
    });
    document.querySelectorAll('button.star[data-slug]').forEach((b) =>
      b.addEventListener('click', () => toggleSlug(b.dataset.slug)),
    );
    paint();
  </script>
  <div id="modreader" hidden>
    <div class="mr-head">
      <strong id="mr-title"></strong>
      <span><a id="mr-open" href="#">open ↗</a> <button class="mr-close" id="mr-close" aria-label="Close">✕</button></span>
    </div>
    <div id="mr-body" class="prose"></div>
  </div>
  <script is:inline>
    // Full-body reader: hover a mod link → fetch its page once, show the
    // rendered prose in a fixed panel. Cached per slug; CSS tooltip above
    // covers the instant summary while loading.
    const reader = document.getElementById('modreader');
    const mrTitle = document.getElementById('mr-title');
    const mrBody = document.getElementById('mr-body');
    const mrOpen = document.getElementById('mr-open');
    const cache = {};
    let timer = null;
    let hideTimer = null;
    const hideReader = () => {
      reader.setAttribute('hidden', '');
    };
    document.getElementById('mr-close').addEventListener('click', hideReader);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideReader();
    });
    document.addEventListener('scroll', hideReader, { passive: true });
    reader.addEventListener('mouseenter', () => clearTimeout(hideTimer));
    reader.addEventListener('mouseleave', hideReader);
    const showReader = async (a) => {
      const href = a.getAttribute('href');
      mrTitle.textContent = a.textContent || '';
      mrOpen.setAttribute('href', href);
      // full content-column width, just under the hovered row
      const card = a.closest('.card');
      const row = a.getBoundingClientRect();
      if (card) {
        const box = card.getBoundingClientRect();
        reader.style.left = `${Math.round(box.left)}px`;
        reader.style.width = `${Math.round(box.width)}px`;
      } else {
        reader.style.left = '1rem';
        reader.style.width = 'min(900px, 94vw)';
      }
      reader.style.top = `${Math.round(row.bottom) + 8}px`;
      reader.removeAttribute('hidden');
      if (cache[href]) {
        mrBody.innerHTML = cache[href];
        return;
      }
      mrBody.innerHTML = '<p class="muted">Loading…</p>';
      try {
        const res = await fetch(href);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const prose = doc.querySelector('.card.prose');
        cache[href] = prose ? prose.innerHTML : '<p class="muted">No preview available.</p>';
      } catch {
        cache[href] = '<p class="muted">Preview failed to load.</p>';
      }
      mrBody.innerHTML = cache[href];
    };
    document.querySelectorAll('a.prev').forEach((a) => {
      a.addEventListener('mouseenter', () => {
        clearTimeout(hideTimer);
        clearTimeout(timer);
        timer = setTimeout(() => showReader(a), 350);
      });
      a.addEventListener('mouseleave', () => {
        clearTimeout(timer);
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideReader, 400);
      });
    });
  </script>
</Base>

<style>
  .kv td:first-child {
    width: auto;
    font-family: inherit;
    font-size: inherit;
    text-transform: none;
    letter-spacing: normal;
    color: inherit;
    background: transparent;
  }
  /* star toggles for the Preferred shortlist (localStorage, this browser) */
  button.star {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--dim, #5f6670);
    padding: 0 0.15rem 0 0;
    font-family: inherit;
  }
  button.star.on {
