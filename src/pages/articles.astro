---
import Base from '../layouts/Base.astro';
import { listMods, type ModView } from '../lib/mods.ts';

interface Article {
  title: string;
  url: string;
  key: string;
  blurb: string;
}

const articles: Article[] = [
  {
    title: 'Harness engineering for coding agent users',
    url: 'https://martinfowler.com/articles/harness-engineering.html',
    key: 'harness-engineering.html',
    blurb: 'Böckeler’s blueprint: guides/sensors, steering loop, keep-quality-left. This harness is built from its figures — every Fig-2 row and lifecycle tool reviewed 1-by-1.',
  },
  {
    title: 'Maintainability sensors for coding agents',
    url: 'https://martinfowler.com/articles/sensors-for-coding-agents.html',
    key: 'sensors-for-coding-agents',
    blurb: 'Sensor experiments with receipts: linting craft, dependency rules, coupling data, modularity review, mutation testing, the sidecar. Our sensor ring’s field manual.',
  },
  {
    title: 'Harness engineering: leveraging Codex in an agent-first world',
    url: 'https://openai.com/index/harness-engineering/',
    key: 'openai.com/index/harness-engineering',
    blurb: 'Agent-first at scale: legibility, invariants-not-implementations, garbage collection. Our newest lens — observability, direction notes, and boundary parsing trace to it.',
  },
];

function linksOf(m: ModView): { label: string; url: string }[] {
  const raw = m.links as unknown;
  if (Array.isArray(raw)) return raw as { label: string; url: string }[];
  try {
    const parsed: unknown = JSON.parse(String(raw ?? '[]'));
    return Array.isArray(parsed) ? (parsed as { label: string; url: string }[]) : [];
  } catch {
    return [];
  }
}

const mods = await listMods();
const withArticles = articles.map((a) => ({
  ...a,
  mods: mods.filter((m) => linksOf(m).some((l) => typeof l?.url === 'string' && l.url.includes(a.key))),
}));
const claimed = new Set(withArticles.flatMap((a) => a.mods.map((m) => m.slug)));
const unmapped = mods.filter((m) => !claimed.has(m.slug));
const session = Astro.locals.session;
---

<Base title="Harness Mods — AI articles" session={session}>
  <p class="kicker">Harness — reading</p>
  <h1>AI articles we work from</h1>
  <p class="muted">
    Three papers, read 1-by-1. Each lists the catalog mods that trace to
    it (matched on mod links) — the receipts that the reading turned
    into harness.
  </p>

  <div class="card">
    <h2 style="margin-top:0">Preferred mods</h2>
    <p class="muted small" style="margin:.3rem 0 .8rem">
      Your shortlist — starred below, kept in this browser only.
    </p>
    <p class="small" id="preferred"><span class="muted">No preferred mods yet — star any mod below.</span></p>
  </div>

  {withArticles.map((a) => (
    <div class="card">
      <h2 style="margin-top:0">
        <a href={a.url} target="_blank" rel="noreferrer">{a.title} ↗</a>
      </h2>
      <p class="muted small" style="margin:.3rem 0 .8rem">{a.blurb}</p>
      {a.mods.length === 0 ? (
        <p class="muted">No mods link here yet.</p>
      ) : (
        <details>
          <summary style="cursor:pointer">Show all {a.mods.length} mods</summary>
          <table class="kv">
            <tbody>
              {a.mods.map((m) => (
                <tr>
                  <td><button class="star" data-slug={m.slug} title="Star as preferred" aria-label={`Star ${m.title}`}>☆</button> <a class="prev" data-sum={m.summary} href={`/mods/${m.slug}`}>{m.title}</a></td>
                  <td class="small muted">{m.category}</td>
                  <td class="small">
                    {m.implemented ? '● implemented' : m.wanted ? '○ wanted' : m.considered ? '◐ considered' : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      )}
    </div>
  ))}

  <div class="card">
    <h2 style="margin-top:0">Not yet mapped ({unmapped.length})</h2>
    <p class="muted small" style="margin:.3rem 0 .8rem">
      Catalog mods with no article link — older entries from before the
      reading program, not necessarily uncovered. Map them by adding the
      article URL to their seed links.
    </p>
    <details>
      <summary style="cursor:pointer">Show all {unmapped.length} unmapped mods</summary>
      <p class="small">
        {unmapped.map((m, i) => (
          <span>{i > 0 && ' · '}<button class="star" data-slug={m.slug} title="Star as preferred" aria-label={`Star ${m.title}`}>☆</button><a class="prev" data-sum={m.summary} href={`/mods/${m.slug}`}>{m.title}</a></span>
        ))}
      </p>
    </details>
  </div>

  <script type="application/json" id="mod-index" set:html={JSON.stringify(mods.map((m) => ({ slug: m.slug, title: m.title }))).replace(/</g, '\\u003c')}></script>
  <script>
    const idx = JSON.parse(document.getElementById('mod-index').textContent || '[]');
    const bySlug = Object.fromEntries(idx.map((m) => [m.slug, m.title]));
    const KEY = 'preferred-mods';
    const load = () => {
      try {
        const v = JSON.parse(localStorage.getItem(KEY) || '[]');
        return Array.isArray(v) ? v.filter((s) => typeof s === 'string' && bySlug[s]) : [];
      } catch {
        return [];
      }
    };
    const save = (slugs) => localStorage.setItem(KEY, JSON.stringify(slugs));
    const paint = () => {
      const slugs = load();
      const box = document.getElementById('preferred');
      box.innerHTML = slugs.length
        ? slugs.map((s, i) => `${i > 0 ? ' · ' : ''}<a href="/mods/${s}">${bySlug[s]}</a>`).join('')
        : '<span class="muted">No preferred mods yet — star any mod below.</span>';
      document.querySelectorAll('button.star').forEach((b) => {
        const on = slugs.includes(b.dataset.slug);
        b.textContent = on ? '★' : '☆';
        b.classList.toggle('on', on);
      });
    };
    document.querySelectorAll('button.star').forEach((b) =>
      b.addEventListener('click', () => {
        const slugs = load();
        const i = slugs.indexOf(b.dataset.slug);
        if (i >= 0) slugs.splice(i, 1);
        else slugs.push(b.dataset.slug);
        save(slugs);
        paint();
      }),
    );
    paint();
  </script>
</Base>

<style>
  .kv td:first-child {
    width: auto;
    font-family: inherit;
    font-size: inherit;
    text-transform: none;
    letter-spacing: normal;
    color: inherit;
    background: transparent;
  }
  /* star toggles for the Preferred shortlist (localStorage, this browser) */
  button.star {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--dim, #5f6670);
    padding: 0 0.15rem 0 0;
    font-family: inherit;
  }
  button.star.on {
    color: var(--accent, #a06a15);
  }
  /* hover overview card: mod summary without navigation (CSS only) */
  a.prev {
    position: relative;
    text-decoration: underline dotted;
  }
  a.prev:hover::after {
    content: attr(data-sum);
    position: absolute;
    left: 0;
    top: 130%;
    z-index: 20;
    width: 320px;
    white-space: normal;
    background: var(--surface, #fff);
    color: var(--text, #1c1e23);
    border: 1px solid var(--border, #cfc8ba);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    font-size: 0.82rem;
    line-height: 1.45;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }
</style>
