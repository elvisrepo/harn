---
import Base from '../layouts/Base.astro';
import C4Diagram from '../components/C4Diagram.astro';
import { listHarnessVersions } from '../lib/harness.ts';
import { loadC4Graph } from '../lib/c4.ts';

const versions = await listHarnessVersions();
const wanted = Number(Astro.url.searchParams.get('v'));
const selected = versions.find((v) => v.version === wanted) ?? versions[0];
const session = Astro.locals.session;

// — per-version diff vs its predecessor, so harness changes stand out —
type DiffRow = { label: string; from: string; to: string };
const prevOf = (v: number) => versions.find((x) => x.version === v - 1);
function diffSnapshot(cur: (typeof versions)[number]): DiffRow[] {
  const prev = prevOf(cur.version);
  if (!prev) return [];
  const out: DiffRow[] = [];
  const s = cur.snapshot;
  const p = prev.snapshot;
  if (s.provider !== p.provider) out.push({ label: 'provider', from: p.provider, to: s.provider });
  if (s.model !== p.model) out.push({ label: 'model', from: p.model, to: s.model });
  const tAdd = s.tools.filter((t) => !p.tools.includes(t));
  const tRem = p.tools.filter((t) => !s.tools.includes(t));
  if (tAdd.length || tRem.length)
    out.push({
      label: 'tools',
      from: `${p.tools.join(' · ')}${tRem.length ? ` <span class=rm>−${tRem.join(',')}</span>` : ''}`,
      to: `${s.tools.join(' · ')}${tAdd.length ? ` <span class=add>+${tAdd.join(',')}</span>` : ''}`,
    });
  if (s.skillsInstalled !== p.skillsInstalled || JSON.stringify(s.skills ?? []) !== JSON.stringify(p.skills ?? [])) {
    const sSkills = s.skills ?? [];
    const pSkills = p.skills ?? [];
    const added = sSkills.filter((x) => !pSkills.includes(x));
    const removed = pSkills.filter((x) => !sSkills.includes(x));
    // compact: only the delta (counts + added/removed lists), never the full before/after lists
    const chip = (list: string[], sign: string, cls: string) =>
      list.length ? ` <span class=${cls}>${sign}${list.join(', ')}</span>` : '';
    out.push({
      label: 'skills',
      from: `${p.skillsInstalled}${chip(removed, '−', 'rm')}`,
      to: `${s.skillsInstalled}${chip(added, '+', 'add')}`,
    });
  }
  if (s.authToken.status !== p.authToken.status)
    out.push({ label: 'credential', from: p.authToken.status, to: s.authToken.status });
  const ct = s.contextTokens?.totalTokens;
  const pt = p.contextTokens?.totalTokens;
  if (ct && !pt) out.push({ label: 'context / turn', from: '—', to: `≈${ct.toLocaleString()}` });
  else if (ct && pt && ct !== pt)
    out.push({
      label: 'context / turn',
      from: `≈${pt.toLocaleString()}`,
      to: `≈${ct.toLocaleString()}`,
    });
  else if (!ct && pt) out.push({ label: 'context / turn', from: `≈${pt.toLocaleString()}`, to: '—' });
  return out;
}
const changes = selected ? diffSnapshot(selected) : [];
const prevVer = selected ? prevOf(selected.version) : undefined;
const changedSet = new Set(versions.filter((v) => diffSnapshot(v).length > 0).map((v) => v.version));

// — diagram highlights track the SELECTED version's diff, so each snapshot's
//   C4 (a versioned artifact at data/c4/v<version>.mmd) reflects what changed
//   at that point in history (v1 barebone → none) —
const hlLabels = changes.map((c) => c.label);
const c4Graph = selected ? loadC4Graph(selected.version, selected.snapshot, hlLabels) : '';

function fmtDate(ms: number | Date) {
  return new Date(ms).toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<Base title={`Harness map — v${selected?.version ?? '—'}`} session={session}>
  <p class="kicker">Harness — map</p>
  <h1>Current harness map</h1>
  <p class="muted">
    A C4 model of the pi coding-agent harness: how it's wired right now, and the
    versioned snapshot of its config + tokens. Modifiable surfaces map to entries
    in the <a href="/">catalog</a>.
  </p>

  <div class="ver-switch">
    <span class="vs-label">Snapshot</span>
    {versions.map((v) => (
      <a
        href={`/harness?v=${v.version}`}
        class={`vs-item${v.version === selected?.version ? ' active' : ''}`}
        title={v.label}
      >
        v{v.version}
        {v.isCurrent && <em> · cur</em>}
      </a>
    ))}
  </div>

  <div class="card">
    <C4Diagram graph={c4Graph} />
  </div>
  {hlLabels.length > 0 && (
    <p class="muted small" style="margin:.2rem 0 .6rem">
      <span style="color:var(--accent);font-weight:700">◆ amber + thick</span> = added/changed in
      this snapshot (v{selected?.version}) — what reached this version
    </p>
  )}

  {selected && (
    <div class="card">
      <div style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between">
        <h2 style="margin:0">
          Snapshot <span class="mono">v{selected.version}</span> · {selected.label}
        </h2>
        {selected.isCurrent && <span class="badge yes">● current</span>}
        {!selected.isCurrent && (
          <a class="small" href="/harness?v=1">
            view current →
          </a>
        )}
      </div>
      <p class="muted small" style="margin:.4rem 0 .9rem">
        Captured {fmtDate(selected.createdAt)}
        {selected.summary && <> — {selected.summary}</>}
      </p>

      {changes.length > 0 && prevVer && (
        <div class="changes">
          <span class="changes-title">Changed since v{prevVer.version}</span>
          {changes.map((c) => (
            <span class="changes-item">
              <b>{c.label}</b>&nbsp;<span set:html={c.from} /> <span class="arr">→</span> <span set:html={c.to} />
            </span>
          ))}
        </div>
      )}
      {changes.some((c) => c.label === 'context / turn') && (
        <p class="muted small" style="margin:-.35rem 0 .9rem">
          Context is measured at capture time — the session-branch part varies with how long that
          session was. A drop/gain here usually means a shorter/longer session at snapshot time,
          not a harness change.
        </p>
      )}

      <table class="kv">
        <tbody>
          <tr>
            <td data-label="Provider">Provider</td>
            <td class="mono">{selected.snapshot.provider}</td>
          </tr>
          <tr>
            <td data-label="Model">Model</td>
            <td class="mono">{selected.snapshot.model}</td>
          </tr>
          <tr>
            <td data-label="Token on each prompt">Token on each prompt</td>
            <td>
              <span class={selected.snapshot.authToken.status === 'present' ? 'badge yes' : 'badge no'}>
                {selected.snapshot.authToken.status === 'present' ? '● present' : '● missing'}
              </span>
              <span class="muted small" style="margin-left:.5rem">
                {selected.snapshot.authToken.source} — {selected.snapshot.authToken.masked}
              </span>
            </td>
          </tr>
          <tr>
            <td data-label="Tools">Tools</td>
            <td class="mono small">{selected.snapshot.tools.join(' · ')}</td>
          </tr>
          <tr>
            <td data-label="Skills">Skills</td>
            <td class="small">
              {selected.snapshot.skillsInstalled === 0
                ? 'none installed'
                : `${selected.snapshot.skillsInstalled} installed`}
              {selected.snapshot.skills?.length > 0 && (
                <span class="muted" style="margin-left:.4rem">
                  — {selected.snapshot.skills.join(' · ')}
                </span>
              )}
            </td>
          </tr>
          <tr>
            <td data-label="Context / turn">Context / turn</td>
            <td class="small">
              {selected.snapshot.contextTokens ? (
                <>
                  <b class="mono">≈ {selected.snapshot.contextTokens.totalTokens.toLocaleString()} tokens</b>
                  <span class="muted small" style="margin-left:.5rem">
                    ({selected.snapshot.contextTokens.estimator} estimate)
                  </span>
                  <details style="margin-top:.35rem">
                    <summary class="mono" style="cursor:pointer;color:var(--dim)">breakdown</summary>
                    <div class="prose mono small" style="margin-top:.4rem;line-height:1.7">
                      <div>base prompt + tool schemas + skills — {selected.snapshot.contextTokens.baseTokens.toLocaleString()}</div>
                      <div>AGENTS.md in &lt;project_context&gt; envelope — {selected.snapshot.contextTokens.instructionsTokens.toLocaleString()}</div>
                      <div>active session branch — {selected.snapshot.contextTokens.branchTokens.toLocaleString()} ({selected.snapshot.contextTokens.branchChars.toLocaleString()} chars)</div>
                      <div class="muted">full durable log (reference, not the context) — {selected.snapshot.contextTokens.durableTokens.toLocaleString()}</div>
                      <div class="muted">current user message + attachments add per turn — varies.</div>
                      <div class="muted" style="margin-top:.3rem;border-top:1px dashed var(--border);padding-top:.3rem">
                        ≈{selected.snapshot.contextTokens.totalTokens.toLocaleString()} is context <i>size</i> — billed input per turn is lower: the repeated prefix (system prompt + earlier turns) hits provider-side prompt caching at the cache-read rate (DeepSeek ≈ 10% of input price; cache breaks after ~5 min idle), and pi auto-compaction keeps old spans as summaries as the session grows.
                      </div>
                      <div class="muted" style="margin-top:.3rem">
                        <b>Capture-time measurement:</b> the <i>branch</i> part above is the size of the session that was active when the snapshot was taken — it varies wildly between snapshots (a short fresh session vs a long one). Drops/gains across versions are measurement, not harness regressions; the base + AGENTS.md parts are the stable harness facts.
                      </div>
                    </div>
                  </details>
                </>
              ) : (
                '— (captured before context measurement)'
              )}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  <div class="card">
    <h2 style="margin-top:0">Versions</h2>
    <p class="muted small">
      Every snapshot records the harness config + tokens at that moment. Take a new
      snapshot from the <a href="/admin">Manage</a> page whenever the harness changes.
    </p>
    <div class="timeline">
      {versions.map((v) => (
        <a
          href={`/harness?v=${v.version}`}
          class={v.version === selected?.version ? 'tl-item active' : 'tl-item'}
        >
          <span class="tl-ver mono">
            v{v.version}
            {v.isCurrent && <span class="tl-cur">· current</span>}
            {changedSet.has(v.version) && <span class="tl-changed">⚡ changed</span>}
          </span>
          <span class="tl-meta">
            <span class="tl-label">{v.label}</span>
            <span class="muted small">{fmtDate(v.createdAt)}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .kv td:first-child {
    width: 200px;
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
    background: transparent;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    margin-top: 0.4rem;
  }
  .ver-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.6rem;
  }
  .vs-label {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
    margin-right: 0.2rem;
  }
  .vs-item {
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--dim);
    background: var(--surface);
    white-space: nowrap;
  }
  .vs-item:hover {
    color: var(--text);
    border-color: var(--accent);
    text-decoration: none;
  }
  .vs-item.active {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg));
    font-weight: 650;
  }
  .vs-item em {
    font-style: normal;
    font-size: 9.5px;
    color: var(--green);
    margin-left: 2px;
  }
  .tl-item {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.5rem 0.6rem;
    border-left: 2px solid var(--border);
    margin-left: 0.3rem;
    border-radius: 0;
  }
  .tl-item:hover {
    background: var(--surface2);
    text-decoration: none;
  }
  .tl-item.active {
    border-left-color: var(--accent);
    background: var(--surface2);
  }
  .tl-ver {
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
    width: 90px;
  }
  .tl-cur {
    color: var(--green);
    font-size: 10px;
    margin-left: 4px;
  }
  .tl-changed {
    color: var(--accent);
    font-size: 10px;
    font-weight: 650;
    margin-left: 6px;
    white-space: nowrap;
  }
  .changes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0.1rem 0 1rem;
  }
  .changes-title {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
    white-space: nowrap;
  }
  .changes-item {
    font-size: 0.82rem;
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, var(--bg));
    border-radius: 999px;
    padding: 3px 11px;
    line-height: 1.35;
  }
  .changes-item b {
    color: var(--accent);
    font-weight: 700;
    text-transform: none;
  }
  .changes-item .arr {
    color: var(--accent);
    font-weight: 700;
  }
  .changes-item .add {
    color: var(--green);
    font-weight: 650;
  }
  .changes-item .rm {
    color: var(--red);
    font-weight: 650;
    text-decoration: line-through;
  }
  .tl-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tl-label {
    color: var(--dim);
    font-size: 0.88rem;
  }
</style>