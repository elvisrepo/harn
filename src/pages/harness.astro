---
import Base from '../layouts/Base.astro';
import C4Diagram from '../components/C4Diagram.astro';
import { listHarnessVersions } from '../lib/harness.ts';

const versions = await listHarnessVersions();
const wanted = Number(Astro.url.searchParams.get('v'));
const selected = versions.find((v) => v.version === wanted) ?? versions[0];
const session = Astro.locals.session;

function fmtDate(ms: number | Date) {
  return new Date(ms).toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

const tokens = selected?.snapshot.designTokens ?? {};
const tokenEntries = Object.entries(tokens);
const colorKeys = ['bg', 'surface', 'surface2', 'surface3', 'border', 'border-strong', 'text', 'dim', 'faint', 'accent', 'green', 'sky', 'red', 'link'];
const colorTokens = tokenEntries.filter(([k]) => colorKeys.includes(k));
const otherTokens = tokenEntries.filter(([k]) => !colorKeys.includes(k));
---

<Base title={`Harness map — v${selected?.version ?? '—'}`} session={session}>
  <p class="kicker">Harness — map</p>
  <h1>Current harness map</h1>
  <p class="muted">
    A C4 model of the pi coding-agent harness: how it's wired right now, and the
    versioned snapshot of its config + tokens. Modifiable surfaces map to entries
    in the <a href="/">catalog</a>.
  </p>

  <div class="card">
    <C4Diagram />
  </div>

  {selected && (
    <div class="card">
      <div style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between">
        <h2 style="margin:0">
          Snapshot <span class="mono">v{selected.version}</span> · {selected.label}
        </h2>
        {selected.isCurrent && <span class="badge yes">● current</span>}
        {!selected.isCurrent && (
          <a class="small" href="/harness?v=1">
            view current →
          </a>
        )}
      </div>
      <p class="muted small" style="margin:.4rem 0 .9rem">
        Captured {fmtDate(selected.createdAt)}
        {selected.summary && <> — {selected.summary}</>}
      </p>

      <table class="kv">
        <tbody>
          <tr>
            <td data-label="Provider">Provider</td>
            <td class="mono">{selected.snapshot.provider}</td>
          </tr>
          <tr>
            <td data-label="Model">Model</td>
            <td class="mono">{selected.snapshot.model}</td>
          </tr>
          <tr>
            <td data-label="Token on each prompt">Token on each prompt</td>
            <td>
              <span class={selected.snapshot.authToken.status === 'present' ? 'badge yes' : 'badge no'}>
                {selected.snapshot.authToken.status === 'present' ? '● present' : '● missing'}
              </span>
              <span class="muted small" style="margin-left:.5rem">
                {selected.snapshot.authToken.source} — {selected.snapshot.authToken.masked}
              </span>
            </td>
          </tr>
          <tr>
            <td data-label="Tools">Tools</td>
            <td class="mono small">{selected.snapshot.tools.join(' · ')}</td>
          </tr>
          <tr>
            <td data-label="Skills">Skills</td>
            <td class="small">
              {selected.snapshot.skillsInstalled === 0
                ? 'none installed'
                : `${selected.snapshot.skillsInstalled} installed`}
            </td>
          </tr>
        </tbody>
      </table>

      <h2 style="margin-top:1.4rem">Design tokens</h2>
      <p class="muted small" style="margin:.2rem 0 .8rem">
        Loaded on every page of this app, dark theme
        {selected.snapshot.lightOverrides ? ' (+ light override)' : ''}.
      </p>
      <div class="token-grid">
        {colorTokens.map(([k, v]) => (
          <div class="token-chip">
            <span class="token-swatch" style={`background:${v}`}></span>
            <span class="mono token-name">{k}</span>
            <span class="mono token-val">{v}</span>
          </div>
        ))}
      </div>
      {otherTokens.length > 0 && (
        <details class="small" style="margin-top:.5rem">
          <summary class="mono" style="cursor:pointer;color:var(--dim)">
            {otherTokens.length} more tokens ({otherTokens.map(([k]) => k).join(', ')})
          </summary>
          <div class="prose mono small" style="margin-top:.5rem">
            {otherTokens.map(([k, v]) => (
              <div>{k}: {v}</div>
            ))}
          </div>
        </details>
      )}
    </div>
  )}

  <div class="card">
    <h2 style="margin-top:0">Versions</h2>
    <p class="muted small">
      Every snapshot records the harness config + tokens at that moment. Take a new
      snapshot from the <a href="/admin">Manage</a> page whenever the harness changes.
    </p>
    <div class="timeline">
      {versions.map((v) => (
        <a
          href={`/harness?v=${v.version}`}
          class={v.version === selected?.version ? 'tl-item active' : 'tl-item'}
        >
          <span class="tl-ver mono">
            v{v.version}{v.isCurrent && <span class="tl-cur">· current</span>}
          </span>
          <span class="tl-meta">
            <span class="tl-label">{v.label}</span>
            <span class="muted small">{fmtDate(v.createdAt)}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .kv td:first-child {
    width: 200px;
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dim);
    background: transparent;
  }
  .token-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.5rem;
  }
  .token-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.6rem;
    background: var(--surface2);
    min-width: 0;
  }
  .token-swatch {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    flex: none;
  }
  .token-name {
    color: var(--text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .token-val {
    margin-left: auto;
    color: var(--faint);
    font-size: 10px;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    margin-top: 0.4rem;
  }
  .tl-item {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.5rem 0.6rem;
    border-left: 2px solid var(--border);
    margin-left: 0.3rem;
    border-radius: 0;
  }
  .tl-item:hover {
    background: var(--surface2);
    text-decoration: none;
  }
  .tl-item.active {
    border-left-color: var(--accent);
    background: var(--surface2);
  }
  .tl-ver {
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
    width: 90px;
  }
  .tl-cur {
    color: var(--green);
    font-size: 10px;
    margin-left: 4px;
  }
  .tl-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .tl-label {
    color: var(--dim);
    font-size: 0.88rem;
  }
</style>