---
import Base from '../layouts/Base.astro';
import {
  listMods,
} from '../lib/mods.ts';
import { listHarnessVersions } from '../lib/harness.ts';

const mods = await listMods();
const versions = await listHarnessVersions();
const categories = [...new Set(mods.map((m) => m.category))].sort();
const session = Astro.locals.session;
const userEmail = session?.user?.email ?? 'unknown';
const editingId = Astro.url.searchParams.get('edit');
---

<Base title="Manage mods" session={session}>
  <p class="kicker">Harness — manage</p>
  <h1>Manage mods</h1>
  <p class="muted small">
    Signed in as <strong>{userEmail}</strong>. Changes go straight to the local
    SQLite database.
  </p>

  <script type="application/json" id="mods-data" set:html={JSON.stringify(mods).replace(/</g, '\\u003c')}></script>

  <div class="card">
    <h2 id="formTitle" style="margin-top: 0">New mod</h2>
    <form id="modForm" class="form-grid">
      <label class="full">
        Title *
        <input type="text" name="title" required autocomplete="off" />
      </label>
      <label>
        Slug (optional — auto-generated from title)
        <input type="text" name="slug" autocomplete="off" />
      </label>
      <label>
        Category
        <input type="text" name="category" list="cats" autocomplete="off" />
        <datalist id="cats">
          {categories.map((c) => <option value={c} />)}
        </datalist>
      </label>
      <label class="full">
        Summary (one-liner shown in the catalog)
        <input type="text" name="summary" autocomplete="off" />
      </label>
      <label class="full">
        Notes / thoughts (markdown)
        <textarea name="body" rows="8" placeholder="What is it, and what are our thoughts?"></textarea>
      </label>
      <label class="full">
        Tags (comma separated)
        <input type="text" name="tags" autocomplete="off" />
      </label>
      <label class="full">
        Links (one per line, format: label | url)
        <textarea name="links" rows="3" placeholder="docs | https://example.com"></textarea>
      </label>
      <label class="check-row">
        <input type="checkbox" name="considered" value="1" /> Considered
      </label>
      <label class="check-row">
        <input type="checkbox" name="implemented" value="1" /> Implemented
      </label>
      <label class="check-row" style="grid-column: 1 / -1">
        <input type="checkbox" name="wanted" value="1" /> Wanted
      </label>
      <div class="full" style="display: flex; gap: 0.6rem; align-items: center">
        <button class="btn" type="submit" id="saveBtn">Save mod</button>
        <button class="btn ghost" type="button" id="resetBtn">Start over</button>
        <span id="formStatus" class="muted small"></span>
      </div>
    </form>
  </div>

  <h2>Harness snapshots</h2>
  <div class="card">
    <p class="muted small">
      Capture a versioned snapshot of the harness: provider/model, token status
      (masked), tools, skills, and the current design tokens. v1 was created at
      setup — snapshot again whenever the harness changes.
    </p>
    <form id="snapForm" class="form-grid" style="margin-top:.6rem">
      <label>
        Label
        <input type="text" name="label" placeholder="e.g. switched provider" autocomplete="off" />
      </label>
      <label>
        Summary
        <input type="text" name="summary" placeholder="what changed?" autocomplete="off" />
      </label>
      <div class="full" style="display:flex;gap:.6rem;align-items:center">
        <button class="btn" type="submit" id="snapBtn">Take snapshot</button>
        <span id="snapStatus" class="small muted"></span>
      </div>
    </form>
  </div>

  <table>
    <thead>
      <tr>
        <th>Version</th>
        <th>Label</th>
        <th>Captured</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {versions.map((v) => (
        <tr>
          <td class="mono" data-label="Version">
            v{v.version}
            {v.isCurrent && <span class="badge yes" style="margin-left:.4rem">● current</span>}
          </td>
          <td data-label="Label">
            <a href={`/harness?v=${v.version}`}>{v.label}</a>
            {v.summary && <div class="muted small">{v.summary}</div>}
          </td>
          <td class="muted small" data-label="Captured">
            {new Date(v.createdAt).toLocaleString()}
          </td>
          <td style="text-align:right;white-space:nowrap" data-label="Actions">
            <a class="btn ghost small" href={`/harness?v=${v.version}`}>View</a>{' '}
            <button class="btn danger" data-delvs={v.id}>Delete</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>All mods ({mods.length})</h2>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {mods.map((m) => (
        <tr>
          <td class="name">
            <a href={`/mods/${m.slug}`}>{m.title}</a>
            <div class="muted small">{m.category}</div>
          </td>
          <td>
            <span class={m.considered ? 'badge yes' : 'badge no'}>
              {m.considered ? '✓ considered' : '✗ not considered'}
            </span>{' '}
            <span class={m.implemented ? 'badge yes' : 'badge no'}>
              {m.implemented ? '✓ implemented' : '✗ not implemented'}
            </span>
            {m.wanted && <span class="badge want">★ wanted</span>}
          </td>
          <td style="text-align: right; white-space: nowrap" data-label="Actions">
            <button class="btn ghost" data-edit={m.id}>Edit</button>{' '}
            <button class="btn danger" data-del={m.id}>Delete</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>

<script>
  interface LinkRec {
    label: string;
    url: string;
  }

  const mods: Array<{
    id: string;
    title: string;
    slug: string;
    category: string;
    summary: string;
    body: string;
    considered: boolean;
    implemented: boolean;
    wanted: boolean;
    tags: string[];
    links: LinkRec[];
  }> = JSON.parse(/* @__PURE__ */ document.getElementById('mods-data')?.textContent ?? '[]');

  const form = document.getElementById('modForm') as HTMLFormElement;
  const formTitle = document.getElementById('formTitle')!;
  const formStatus = document.getElementById('formStatus')!;
  const statuses = ['considered', 'implemented', 'wanted'];
  let editingId: string | null = null;

  function setStatus(msg: string) {
    formStatus.textContent = msg;
    setTimeout(() => (formStatus.textContent = ''), 4000);
  }

  function fillForm(m: (typeof mods)[number]) {
    editingId = m.id;
    formTitle.textContent = `Edit: ${m.title}`;
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    el('title').value = m.title;
    el('slug').value = m.slug;
    el('category').value = m.category;
    el('summary').value = m.summary;
    el('body').value = m.body;
    el('tags').value = m.tags.join(', ');
    el('links').value = m.links.map((l) => `${l.label} | ${l.url}`).join('\n');
    for (const s of statuses) {
      (form.elements.namedItem(s) as HTMLInputElement).checked = (m as unknown as Record<string, boolean>)[s];
    }
  }

  function resetForm() {
    editingId = null;
    formTitle.textContent = 'New mod';
    form.reset();
  }

  document.getElementById('resetBtn')!.addEventListener('click', resetForm);

  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const m = mods.find((x) => x.id === btn.dataset.edit);
      if (m) {
        fillForm(m);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const m = mods.find((x) => x.id === btn.dataset.del);
      if (!m) return;
      if (!confirm(`Delete "${m.title}"?`)) return;
      const res = await fetch(`/api/mods?id=${m.id}`, {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
      });
      if (res.ok) window.location.reload();
      else setStatus('Delete failed');
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const links: LinkRec[] = String(data.get('links') || '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const i = line.lastIndexOf('|');
        return i === -1
          ? { label: line, url: line }
          : { label: line.slice(0, i).trim(), url: line.slice(i + 1).trim() };
      });
    const payload = {
      id: editingId ?? undefined,
      title: String(data.get('title')),
      slug: String(data.get('slug') || ''),
      category: String(data.get('category') || 'Uncategorized'),
      summary: String(data.get('summary') || ''),
      body: String(data.get('body') || ''),
      considered: data.get('considered') === '1',
      implemented: data.get('implemented') === '1',
      wanted: data.get('wanted') === '1',
      tags: String(data.get('tags') || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean),
      links,
    };
    const res = await fetch('/api/mods', {
      method: editingId ? 'PUT' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const body = await res.json().catch(() => ({}));
    if (res.ok) {
      setStatus(editingId ? 'Updated ✓' : 'Created ✓');
      resetForm();
      setTimeout(() => window.location.reload(), 300);
    } else {
      setStatus(`Error: ${(body as { error?: string }).error ?? res.status}`);
    }
  });

  const editParam = new URLSearchParams(window.location.search).get('edit');
  if (editParam) {
    const m = mods.find((x) => x.id === editParam);
    if (m) fillForm(m);
  }

  // --- harness snapshots ---
  const snapForm = document.getElementById('snapForm') as HTMLFormElement;
  const snapStatus = document.getElementById('snapStatus')!;
  snapForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(snapForm);
    snapStatus.textContent = 'snapshotting…';
    const res = await fetch('/api/harness-versions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ label: data.get('label'), summary: data.get('summary') }),
    });
    const body = await res.json().catch(() => ({}));
    if (res.ok) {
      snapStatus.textContent = `v${(body as { version: number }).version} created ✓`;
      setTimeout(() => window.location.reload(), 400);
    } else {
      snapStatus.textContent = `Error: ${(body as { error?: string }).error ?? res.status}`;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-delvs]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this harness snapshot?')) return;
      const res = await fetch(`/api/harness-versions?id=${btn.dataset.delvs}`, {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
      });
      if (res.ok) window.location.reload();
      else alert('Delete failed');
    });
  });
</script>