---
// C4 architecture model of the current harness (pi coding-agent).
// Rendered client-side with Mermaid — theme pulled from the app's design
// tokens at runtime (single source: src/styles/global.css).
// Structure: ordered pipeline — 1 LOAD → 2 COMPOSE → 3 AGENT LOOP →
// reply/persist; numbered edges trace the full cycle.
---
<div class="mmd" id="harness-mermaid" aria-label="C4 architecture of the pi coding-agent harness"></div>

<script>
  import mermaid from 'mermaid';

  const root = document.getElementById('harness-mermaid');
  if (!root) throw new Error('harness-mermaid container missing');

  const cs = getComputedStyle(document.documentElement);
  const token = (name, fallback) => cs.getPropertyValue(name).trim() || fallback;
  const bg = token('--bg', '#0b0d10');
  const surface = token('--surface', '#12151a');
  const border = token('--border-strong', '#2d3542');
  const dim = token('--dim', '#98a1ad');
  const text = token('--text', '#e5e8ed');
  const sky = token('--sky', '#79b6e8');
  const accent = token('--accent', '#e3b35c');
  const green = token('--green', '#7cc47f');
  const red = token('--red', '#e0736b');
  const sans = token('--sans', 'system-ui, sans-serif');
  // mermaid classDef/style grammar rejects CSS functions like color-mix() —
  // precompute flat hex tints from the live tokens instead.
  const parseHex = (h) => {
    h = h.replace('#', '');
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
  };
  const tint = (hex, p) => {
    const fg = parseHex(hex);
    const bgc = parseHex(bg);
    const m = fg.map((v, i) => {
      const c = Math.round(bgc[i] + (v - bgc[i]) * p);
      return Math.min(255, Math.max(0, c));
    });
    return '#' + m.map((v) => v.toString(16).padStart(2, '0')).join('');
  };

  const graph = `flowchart TB
  Dev["👤 Developer (you)<br/>leads the session"]:::person
  Dev -->|uses| PI
  subgraph PI["pi coding agent · v0.84.4"]
    direction TB
    subgraph LOAD["1 · LOAD — session + config"]
      direction LR
      TUI["▣ pi CLI · TUI<br/>terminal · manages sessions"]:::container
      SESS["⎙ Session history<br/>append-only JSONL · parent pointers"]:::container
      CFG["▤ Config & state<br/>settings.json · trust.json"]:::container
    end
    subgraph COMPOSE["2 · COMPOSE — per-turn context"]
      direction LR
      ASM["⎘ Context assembler<br/>base prompt · project instructions<br/>skills catalog · extension hooks"]:::container
    end
    subgraph LOOP["3 · AGENT LOOP — tools · model"]
      direction LR
      ORCH["◎ Agent orchestration<br/>the core loop"]:::container
      TOOLS["⚙ Tools<br/>read · bash · edit · write"]:::container
      MODEL["◈ Model provider<br/>routes prompts to an LLM"]:::container
      AUTH["🔑 Auth / credentials<br/>token on every prompt"]:::container
      MS["🗎 models-store.json<br/>provider/model catalog"]:::file
    end
    TUI -->|1 · open session| SESS
    SESS -->|2 · branch + compaction| ASM
    CFG -->|3 · config| ASM
    ASM -->|4 · per-turn context| ORCH
    ORCH -->|5 · invoke| TOOLS
    TOOLS -->|6 · results| ORCH
    ORCH -->|7 · LLM request| MODEL
    AUTH -->|8 · token| MODEL
    MODEL -.->|9 · resolve provider/model| MS
    MODEL -->|10 · reply| ORCH
    ORCH -->|11 · streamed reply| TUI
    TUI -.->|12 · appends JSONL| SESS
  end
  MODS["▦ Harness Mods (web app)<br/>catalog + admin · snapshots · map"]:::system
  FILES["▤ Harness files<br/>settings · auth (presence) · tokens"]:::system
  MODS -.->|reads · snapshots| FILES
  MODS -.->|tracks config + token status| PI
  classDef person fill:${tint(sky, 0.16)},stroke:${sky},stroke-width:2
  classDef system fill:${tint(accent, 0.15)},stroke:${accent},stroke-width:2
  classDef container fill:${tint(green, 0.12)},stroke:${green},stroke-width:2
  classDef file fill:${surface},stroke:${border},stroke-width:1.5
  style LOAD fill:${tint(sky, 0.05)},stroke:${sky},stroke-width:2
  style COMPOSE fill:${tint(accent, 0.05)},stroke:${accent},stroke-width:2
  style LOOP fill:${tint(green, 0.05)},stroke:${green},stroke-width:2
  style PI fill:${tint(border, 0.1)},stroke:${border},stroke-width:2
  linkStyle 5,6 stroke:${green},color:${green}
  linkStyle 8 stroke:${red},color:${red}
  linkStyle 7,10 stroke:${sky},color:${sky}
  linkStyle 9,13,14 stroke:${dim},color:${dim}
`;

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: 'loose',
    theme: 'base',
    themeVariables: {
      background: bg,
      mainBkg: surface,
      nodeBorder: border,
      clusterBkg: bg,
      clusterBorder: border,
      lineColor: accent,
      edgeLabelBackground: bg,
      textColor: text,
      titleColor: text,
      fontFamily: sans,
      fontSize: '14px',
    },
    flowchart: {
      htmlLabels: true,
      curve: 'basis',
      padding: 16,
      nodeSpacing: 50,
      rankSpacing: 60,
    },
  });

  try {
    const res = await mermaid.render('harnessMmd', graph);
    root.innerHTML = res.svg;
    // file node renders dashed to read as a config note
    root.querySelectorAll('.file rect').forEach((r) => r.setAttribute('stroke-dasharray', '5 5'));
  } catch (err) {
    root.innerHTML =
      `<p class="muted small" style="padding:1rem">Diagram failed to render (${err.message})</p>`;
  }
</script>

<style>
  .mmd {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.4rem 0;
  }
  .mmd svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>