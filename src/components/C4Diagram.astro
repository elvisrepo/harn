---
// Renders a versioned C4 mermaid source (built by lib/c4.ts and persisted as
// data/c4/v<version>.mmd). The palette is baked into the artifact at
// generation time, so this component only mounts the graph and renders it.
interface Props { graph: string }
const { graph = '' } = Astro.props as Props;
---
<div class="mmd" id="harness-mermaid" aria-label="C4 architecture of the pi coding-agent harness" data-graph={graph}></div>

<script>
  import mermaid from 'mermaid';

  const root = document.getElementById('harness-mermaid');
  if (!root) throw new Error('harness-mermaid container missing');
  const graph = root.dataset.graph || '';

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: 'loose',
    theme: 'base',
    themeVariables: {
      background: '#f6f4f0',
      mainBkg: '#ffffff',
      nodeBorder: '#cfc8ba',
      clusterBkg: '#f6f4f0',
      clusterBorder: '#cfc8ba',
      lineColor: '#a06a15',
      edgeLabelBackground: '#f6f4f0',
      textColor: '#1c1e23',
      titleColor: '#1c1e23',
      fontFamily: 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
      fontSize: '14px',
    },
    flowchart: {
      htmlLabels: true,
      curve: 'basis',
      padding: 16,
      nodeSpacing: 50,
      rankSpacing: 60,
    },
  });

  const render = async () => {
    try {
      const res = await mermaid.render('harnessMmd', graph);
      root.innerHTML = res.svg;
      // file node renders dashed to read as a config note
      root.querySelectorAll('.file rect').forEach((r2) => r2.setAttribute('stroke-dasharray', '5 5'));
    } catch (err) {
      root.innerHTML =
        `<p class="muted small" style="padding:1rem">Diagram failed to render (${err.message})</p>`;
    }
  };
  render();
</script>

<style>
  .mmd {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.4rem 0;
  }
  .mmd svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>