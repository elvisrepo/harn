---
interface Props {
  session?: { user: { name?: string; email?: string } } | null;
}
const { session = null } = Astro.props;
const currentPath = Astro.url.pathname;
---
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/">⚙ Harness Mods</a>
    <nav class="nav">
      <a href="/" aria-current={currentPath === '/' || currentPath.startsWith('/mods/') ? 'page' : undefined}>Catalog</a>
      <a href="/articles" aria-current={currentPath === '/articles' ? 'page' : undefined}>Articles</a>
      <a href="/harness" aria-current={currentPath === '/harness' ? 'page' : undefined}>Harness map</a>
      <a href="/docs/coupling/dashboard.html" aria-current={currentPath === '/docs/coupling/dashboard.html' ? 'page' : undefined}>Coupling</a>
      <a href="/docs/sensors/history.html" aria-current={currentPath === '/docs/sensors/history.html' ? 'page' : undefined}>Sensors</a>
      <a href="/admin" aria-current={currentPath === '/admin' ? 'page' : undefined}>Manage</a>
    </nav>
    <div class="who">
      {session ? (
        <>
          <span class="email">{session.user.email}</span>
          <button id="logout" class="link-btn" type="button">Sign out</button>
        </>
      ) : (
        <a href="/login">Sign in</a>
      )}
    </div>
  </div>
</header>

<script>
  import { authClient } from '../lib/auth-client.ts';

  const btn = document.getElementById('logout');
  btn?.addEventListener('click', async () => {
    await authClient.signOut();
    window.location.href = '/';
  });
</script>
