{
  "name": "harness-mods",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "check": "astro build && node scripts/qa-flows.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "astro": "^7.2.9",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "marked": "^16.3.1",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.5",
    "playwright-core": "^1.62.1"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true
  }
}
