{
  "name": "harness-mods",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "check": "astro build && astro check && node scripts/check-secrets.mjs && node scripts/qa-flows.mjs",
    "versions:export": "node scripts/export-versions.mjs",
    "versions:import": "node scripts/import-versions.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "astro": "^7.2.9",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "marked": "^16.3.1",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.5",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true
  }
}
