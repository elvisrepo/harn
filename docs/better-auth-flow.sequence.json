  "cards": [
    {
      "dot": "emerald",
      "title": "Sign-in",
      "items": [
        "Email/password posted to better-auth's route; hashed credential verified",
        "A session is created and set as an httpOnly cookie",
        "signUp API exists only for seed convenience \u2014 no register UI"
      ]
    },
    {
      "dot": "rose",
      "title": "Session protection",
      "items": [
        "Astro middleware runs auth.api.getSession on protected requests",
        "/admin and every mutation API (POST/PUT/DELETE) require a session",
        "Astro's origin check blocks cross-site mutations"
      ]
    },
    {
      "dot": "orange",
      "title": "Storage",
      "items": [
        "Password stored as a scrypt hash in account.password \u2014 never the provider credential",
        "The pi credential (~/.pi/agent/auth.json) is only probed for existence",
        "Sessions cascade-delete with the user row"
      ]
    }
  ]
