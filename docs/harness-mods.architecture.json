  "cards": [
    {
      "dot": "cyan",
      "title": "Auth & scope",
      "items": [
        "Email/password via better-auth; hash stored, provider credential never read",
        "/admin and mutation APIs require a session; Astro blocks cross-site writes",
        "signUp API enabled only for seed convenience \u2014 no register UI"
      ]
    },
    {
      "dot": "emerald",
      "title": "App & data",
      "items": [
        "Astro 7 SSR with @astrojs/node; vanilla JS + Mermaid render the harness map",
        "SQLite WAL via better-sqlite3 + drizzle; mods tags/links stored as JSON",
        "harness_versions keep masked token status + a data/c4/v<n>.mmd artifact each"
      ]
    },
    {
      "dot": "rose",
      "title": "Harness facts (read-only)",
      "items": [
        "Provider/model from ~/.pi/agent/settings.json; token presence only",
        "Skills counted across ~/.pi/agent/skills and .pi/skills (symlinks resolved)",
        "Firecrawl CLI handles web search/scrape \u2014 API key never read by the app"
      ]
    }
  ],
